# Development is ready to run without this file. Copy it to .env only when you
# want to override defaults or use the PostgreSQL Compose service.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Production must use a long random secret and its public host names.
# DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
# DJANGO_ALLOWED_HOSTS=tanu.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tanu.example.org
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_TRUST_PROXY_HEADERS=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true

# Set POSTGRES_HOST to opt into PostgreSQL. The other values shown here match
# compose.yaml and are for local development only.
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=tanu
# POSTGRES_USER=tanu
# POSTGRES_PASSWORD=tanu-development-only
